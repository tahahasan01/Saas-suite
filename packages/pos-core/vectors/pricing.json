{
  "spec": "packages/pos-core/vectors/README.md",
  "version": 1,
  "units": "All amounts are integer minor units (paisa). qty and tax_rate_pct are decimals.",
  "change_control": "Changing or removing a vector needs the engineering lead and the money-correctness owner, plus a release note (docs/14-checklists.md 6.1).",
  "vectors": [
    {
      "id": "PV-01",
      "case": "Tax-exclusive total (the P0-5 regression)",
      "kind": "sale",
      "input": {
        "tax_on": true, "tax_inclusive": false, "order_discount_minor": 0,
        "tender": "card", "cash_rounding_minor": 100,
        "lines": [{"unit_price_minor": 100000, "qty": 1, "tax_rate_pct": 18}]
      },
      "expected": {
        "lines": [{"gross_minor": 100000, "line_discount_minor": 0, "line_net_minor": 100000,
                   "discount_share_minor": 0, "net_minor": 100000,
                   "excl_minor": 100000, "tax_minor": 18000, "incl_minor": 118000}],
        "subtotal_minor": 100000, "line_discount_minor": 0, "order_discount_minor": 0,
        "tax_minor": 18000, "total_minor": 118000, "rounding_minor": 0, "amount_due_minor": 118000
      }
    },
    {
