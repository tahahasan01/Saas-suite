# Business OS production settings — template for /opt/business-os/prod.env on
# the server (chmod 600, owned by the deploy user, NEVER committed).
# Every value here is a placeholder. Generate secrets on the server:
#   openssl rand -hex 24                     (passwords: hex keeps URLs valid)
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"   (data key)
# The API refuses to boot on any default/short password or a missing data key.

# ── Domains (no domain yet: any temporary domain on Cloudflare works for staging)
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
# cloudflare = Let's Encrypt via DNS-01 (token: Zone → DNS → Edit, this zone only)
CADDY_TLS=cloudflare
CLOUDFLARE_API_TOKEN=replace-me

# ── Database (owner role = migrations; app_user = runtime, RLS enforced)
POSTGRES_USER=businessos
POSTGRES_DB=businessos
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
APP_DB_PASSWORD=replace-with-a-different-openssl-rand-hex-24

# ── Redis
REDIS_PASSWORD=replace-with-openssl-rand-hex-24

# ── Credential encryption master key(s) (FBR tokens …). Keep an offline copy:
# losing it means every tenant must re-enter their FBR token.
BOS_DATA_KEYS={"k1":"replace-with-base64-of-32-random-bytes"}
BOS_DATA_KEY_ACTIVE=k1

# ── Off-site backups: Cloudflare R2 (S3-compatible). Create the bucket first,
# then an R2 API token scoped to it ("Object Read & Write").
BACKUP_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=business-os-backups
BACKUP_S3_REGION=auto
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
BACKUP_PREFIX=business-os
# age PUBLIC keys only (space separated). The private keys stay off this server.
BACKUP_AGE_RECIPIENTS=age1replace-founder-key age1replace-escrow-key
# Nightly run time in UTC (21:30 UTC = 02:30 PKT)
BACKUP_TIME_UTC=21:30
# Optional dead-man's switch, e.g. a healthchecks.io check URL
BACKUP_HEALTHCHECK_URL=

# ── App
EMAIL_PROVIDER=smtp
EMAIL_FROM=Business OS <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SENTRY_DSN=
ANTHROPIC_API_KEY=
# The release tag for Sentry and logs (the deploy sets it to the commit SHA).
GIT_SHA=

# ── Stack
IMAGE_TAG=latest
# Internal network; the API trusts X-Forwarded-For only from inside it.
COMPOSE_SUBNET=172.30.0.0/24
