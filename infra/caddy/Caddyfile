# Business OS edge (gates I4, S9, S12). Environment:
#   APP_DOMAIN      app.example.com   (web)
#   API_DOMAIN      api.example.com   (API)
#   ACME_EMAIL      ops@example.com   (Let's Encrypt account / expiry notices)
#   CADDY_TLS       cloudflare (default: Let's Encrypt via Cloudflare DNS-01,
#                   needs CLOUDFLARE_API_TOKEN with Zone:DNS:Edit) | internal
#                   (Caddy's local CA — local checks only, never production)
#   CLOUDFLARE_API_TOKEN
{
	email {$ACME_EMAIL:ops@example.com}
	servers {
		# The real client IP comes from CF-Connecting-IP — but only when the
		# connection itself is from Cloudflare. Anyone else sending that
		# header is ignored, so a forged IP cannot dodge the rate limiter.
		# Ranges: https://www.cloudflare.com/ips/ (re-check quarterly).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
}

(tls_internal) {
	tls internal
}

(common) {
	import tls_{$CADDY_TLS:cloudflare}
	# 5 MB ceiling at the door (P1-8); the API enforces its own too (S12).
	request_body {
		max_size 5MB
	}
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header {
		# 2 years; add "preload" only after the founder submits the domain.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
		-X-Powered-By
	}
}

{$API_DOMAIN:api.localhost} {
	import common
	header {
		defer
		# The API never serves a page to frame or script to run.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
	# uvicorn trusts X-Forwarded-For only from this proxy's network
	# (FORWARDED_ALLOW_IPS). It is replaced, not appended to, with the client
	# IP resolved above — otherwise the app would see Cloudflare's address.
	reverse_proxy api:4000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

{$APP_DOMAIN:app.localhost} {
	import common
	header {
		defer
		# The page CSP (with nonces) is set by the web app itself (next.config,
		# Phase 2A "security headers"); the edge only forbids framing.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}
