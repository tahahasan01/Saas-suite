# ─── Database ─────────────────────────────────────────────
POSTGRES_USER=businessos
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=businessos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Owner connection — migrations + auth/signup lookups (bypasses RLS as table owner)
DATABASE_URL=postgres://businessos:change_me_in_prod@localhost:5432/businessos
# Runtime connection — tenant-scoped queries as non-owner role (RLS enforced)
APP_DATABASE_URL=postgres://app_user:app_user_pw@localhost:5432/businessos

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── API ──────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
# Error tracking (optional; no-op if empty). GIT_SHA tags the release (CI sets it).
SENTRY_DSN=
GIT_SHA=
# Logs: json (default; production) or text (a dev terminal). Both redact PII.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Reverse proxy CIDRs (comma-separated) whose X-Forwarded-For is believed, e.g.
# the Caddy container network 172.16.0.0/12. Empty = use the direct peer only.
TRUSTED_PROXY_CIDRS=
# Rate limits, lockouts and alert de-dup live under this Redis key prefix (Redis 7+).
REDIS_PREFIX=bos:
# Where /ready reads the migration files (default: <repo>/infra/migrations).
MIGRATIONS_DIR=

# ─── Worker (python -m app.worker) ────────────────────────
# Jobs and outbox consumers run only in the worker; the API runs no scheduler.
WORKER_POLL_S=5
WORKER_HEARTBEAT_FILE=

# ─── Alerts ───────────────────────────────────────────────
# Optional JSON POST per alert (Slack/Discord/ntfy-style incoming webhook).
ALERT_WEBHOOK_URL=
# Thresholds per 5-minute window, and the outbox lag that alerts (minutes).
ALERT_5XX_PER_5MIN=20
ALERT_401_PER_5MIN=200
ALERT_RATELIMIT_PER_5MIN=200
OUTBOX_LAG_ALERT_MIN=30
# 32+ byte random string; used to sign session cookies
SESSION_SECRET=replace_with_openssl_rand_hex_32
NODE_ENV=development

# ─── Web ──────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Email ────────────────────────────────────────────────
# 'console' logs links in dev; 'smtp' sends for real (fill SMTP_* below).
EMAIL_PROVIDER=console
EMAIL_FROM=Business OS <no-reply@businessos.pk>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── AI (Phase 1) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── WhatsApp Cloud API (Phase 1) ─────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── Payments (Phase 1) ───────────────────────────────────
PAYMENT_PROVIDER=manual
SAFEPAY_API_KEY=
